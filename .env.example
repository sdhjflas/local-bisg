# ============================================================
# BISG Labels - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values
# For production, set these in Railway dashboard instead
# ============================================================

# ------------------------------------------------------------
# Flask Configuration
# ------------------------------------------------------------
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-generate-a-new-one
FLASK_DEBUG=False
PORT=5000

# Environment: development or production
FLASK_ENV=production

# ------------------------------------------------------------
# Stripe Configuration
# ------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# WARNING: Use test keys (sk_test_) for development
#          Use live keys (sk_live_) for production only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------------------------
# Google Sheets Configuration
# ------------------------------------------------------------
# Sheet IDs from Google Sheets URLs
# Example: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
STOCK_SHEET_ID=your_stock_sheet_id
FORM_SHEET_ID=your_form_sheet_id

# ------------------------------------------------------------
# Google Cloud Credentials (JSON)
# ------------------------------------------------------------
# For Railway: Paste the entire JSON content as a single line
# For local dev: Use file path or JSON string
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SHEETS_CREDS={"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","client_secret":"...","redirect_uris":["..."]}}

# ------------------------------------------------------------
# Gmail API Configuration
# ------------------------------------------------------------
# Gmail token for sending emails (JSON format)
# Generate using: python scripts/generate_gmail_token.py
GMAIL_TOKEN={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"..."}

# Sender email address (must match Gmail account)
SENDER_EMAIL=your-email@domain.com

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
# Directory for generated label files (use /tmp for Railway)
LABEL_OUTPUT_DIR=/tmp/bisg-labels

# Rate limiting (requests per minute)
RATE_LIMIT_CHECKOUT=10
RATE_LIMIT_WEBHOOK=100

# ------------------------------------------------------------
# Security Settings (Production Only)
# ------------------------------------------------------------
# Allowed CORS origins (comma-separated)
# For production, use your actual domain
ALLOWED_ORIGINS=https://app.bisglabels.com,https://bisglabels.com

# Session timeout in minutes
SESSION_TIMEOUT=30

# ------------------------------------------------------------
# Monitoring & Error Tracking (Optional)
# ------------------------------------------------------------
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Feature Flags (Optional)
# ------------------------------------------------------------
# Enable/disable features
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_RATE_LIMITING=True
ENABLE_REQUEST_LOGGING=True

# ------------------------------------------------------------
# Notes for Railway Deployment
# ------------------------------------------------------------
# 1. Never commit .env to git (already in .gitignore)
# 2. Set all variables in Railway dashboard under "Variables" tab
# 3. For JSON variables, paste as single line without newlines
# 4. Restart deployment after changing variables
# 5. Use Railway's built-in secrets management for sensitive data
